set-game-preset-decoy-error = Если указан аргумент 3, он должен быть допустимым пресетом. Не удалось найти игровой пресет "{$preset}"

#set-game-preset-preset-set = Set game preset to "{$preset}"
set-game-preset-preset-set-finite = Установлен игровой пресет "{ $preset }" на следующие { $rounds } раундов.
set-game-preset-preset-set-finite-with-decoy = Установлен игровой пресет "{$preset}" на следующие {$rounds} раундов; в лобби отображается {$decoy}.
