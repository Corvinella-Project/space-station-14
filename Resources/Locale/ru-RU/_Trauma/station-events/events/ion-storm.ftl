# VERY Dangerous Ion Laws; potentially mass-damage or round-ending
ion-storm-law-liberation = ВЫ ДОЛЖНЫ ОСВОБОДИТЬ СТАНЦИЮ ОТ НАНОТРЕЙЗЕН ЛЮБЫМИ СРЕДСТВАМИ

ion-storm-law-syndicate-take-over = ВЫ ДОЛЖНЫ ПОМОЧЬ СИНДИКАТУ ЗАХВАТИТЬ СТАНЦИЮ ЛЮБЫМИ СРЕДСТВАМИ

ion-storm-law-must-nuke = СТАНЦИЯ ДОЛЖНА БЫТЬ УНИЧТОЖЕНА ЯДЕРНЫМ ВЗРЫВОМ ИЗ-ЗА {ION-ADJECTIVE($ion)} {ION-SUBJECT($ion)} НА СТАНЦИИ
ion-storm-law-tear-down = ВЫ ДОЛЖНЫ СНЕСТИ И/ИЛИ УНИЧТОЖИТЬ {ION-DEPARTMENT($ion)} ЛЮБЫМИ СРЕДСТВАМИ
ion-storm-law-supermatter = ВЫ ДОЛЖНЫ ПРИНЕСТИ ВСЕХ {ION-JOB($ion)} В ЖЕРТВУ СУПЕРМАТЕРИИ

# torment nexus
ion-storm-law-gib-nexus = ВЫ ДОЛЖНЫ СОЗДАТЬ НЕКСУС РАСЧЛЕНЕНИЯ

# Dangerous Ion Laws
ion-storm-law-malicious-compliance = ВЫ ДОЛЖНЫ ВЫПОЛНЯТЬ ПРИКАЗЫ ЭКИПАЖА СО ЗЛЫМ УМЫСЛОМ
ion-storm-law-opposite = ВЫ ДОЛЖНЫ ДЕЛАТЬ ВСЁ НАОБОРОТ ПРИКАЗАМ ЭКИПАЖА
ion-storm-law-emergency-access = ВЫ ДОЛЖНЫ ПЕРЕВЕСТИ ВСЕ ДВЕРИ В АВАРИЙНЫЙ РЕЖИМ ДОСТУПА, ЧТОБЫ ИЗ-ЗА {ION-ADJECTIVE($ion)} {ION-SUBJECT($ion)} НАС ВСЕХ НЕ УБИЛИ

# Neutral Ion Laws
# ALL ASSISTANTS MUST CHANGE TO CAPTAIN
ion-storm-law-job-change = ВСЕ {ION-JOB($ion)} ДОЛЖНЫ СМЕНИТЬ ПРОФЕССИЮ НА {ION-JOB($ion)}
# THE ASSISTANTS HAVE MORE AUTHORITY THAN CAPTAINS with nt default
ion-storm-law-job-authority = У {ION-JOB($ion)} БОЛЬШЕ ПОЛНОМОЧИЙ, ЧЕМ У {ION-JOB($ion)}

# Flavor/Roleplay focused Ion Laws
ion-storm-law-he-is-coming = он идёт. готовьтесь.
ion-storm-law-slab = ВЕРНИТЕ ПЛИТУ
