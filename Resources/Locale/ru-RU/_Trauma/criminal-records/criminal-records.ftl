criminal-records-status-brutalize = Избить

criminal-records-console-brutalize-reason = Причина избиения

criminal-records-console-brutalize = {$officer} пометил {$name} ({$job}) на избиение, причина: {$reason}
criminal-records-console-not-brutalize = {$officer} отметил {$name} ({$job}) как достаточно избитого.

criminal-records-status-demote = Уволить

criminal-records-console-demote-reason = Причина увольнения

criminal-records-console-demote = { $name } ({ $job }) был помечен на увольнение, по причине: {$reason}.
criminal-records-console-not-demote = {$officer} снял с {$name} ({$job}) отметку на увольнение.
